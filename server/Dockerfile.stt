FROM python:3.11-slim
WORKDIR /app
# faster-whisper trae PyAV (ffmpeg embebido): no hace falta ffmpeg del sistema.
RUN pip install --no-cache-dir faster-whisper
COPY scripts/stt_server.py ./stt_server.py
ENV STT_MODEL=Systran/faster-whisper-small \
    HF_HOME=/models
VOLUME /models
EXPOSE 8000
# Forma shell para expandir STT_MODEL. Solo se publica dentro de la red de compose.
CMD python stt_server.py --device cpu --host 0.0.0.0 --port 8000 --model "$STT_MODEL"
