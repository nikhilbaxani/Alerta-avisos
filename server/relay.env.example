# Copia este archivo a server/relay.env y rellénalo (no se sube al repositorio).

# Dirección que sirve Caddy dentro del contenedor. ":8080" = HTTP plano detrás de Tailscale Funnel (el HTTPS lo pone Funnel).
# Con un dominio propio (p. ej. demo.ejemplo.com) Caddy pide el certificado solo (ver server/README.md, «Pasar a un dominio»).
SITE_ADDRESS=:8080

# Token del operador para /events: openssl rand -hex 24
RELAY_TOKEN=

# Origen público de la web (sin barra final): la URL de Funnel https://<nodo>.<tailnet>.ts.net. Varios orígenes, separados por comas.
# Debe estar aquí aunque la web y el relay compartan origen: el navegador envía Origin en el POST.
ALLOWED_ORIGINS=https://nodo.tu-tailnet.ts.net

# Duración máxima de una llamada en segundos (el servidor rechaza > máximo + 5 s; la web se construye con este mismo valor).
MAX_CALL_SECONDS=120

# Llamadas por IP y ventana en minutos. Si Funnel no pasa la IP del cliente, súbelo (p. ej. RATE_LIMIT=60).
RATE_LIMIT=3
RATE_WINDOW_MIN=10

# Modelo de Whisper en CPU. small (~460 MB) es el equilibrio; base/tiny si el VPS va justo.
STT_MODEL=Systran/faster-whisper-small

# Puerto local del host (solo 127.0.0.1) que publica Funnel. Cámbialo si 8080 ya está en uso.
WEB_PORT=8080
