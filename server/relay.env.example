# Copia este archivo a server/relay.env y rellénalo (no se sube al repositorio).

# Dominio público del relay (registro DNS A hacia la IP del VPS). Caddy pide el certificado solo.
RELAY_DOMAIN=relay.ejemplo.com

# Token del operador para /events: openssl rand -hex 24
RELAY_TOKEN=

# URL de la consola en Vercel (sin barra final). Varios orígenes separados por comas.
ALLOWED_ORIGINS=https://tu-consola.vercel.app

# Duración máxima de una llamada en segundos (el servidor rechaza > máximo + 5 s).
MAX_CALL_SECONDS=120

# Llamadas por IP y ventana en minutos.
RATE_LIMIT=3
RATE_WINDOW_MIN=10

# Modelo de Whisper en CPU. small (~460 MB) es el equilibrio; base/tiny si el VPS va justo.
STT_MODEL=Systran/faster-whisper-small
