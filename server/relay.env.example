# Copia este archivo a server/relay.env y rellénalo (no se sube al repositorio).

# Dirección que sirve Caddy dentro del contenedor. ":8080" = HTTP plano detrás de Tailscale Funnel (el HTTPS lo pone Funnel).
# Con un dominio propio (p. ej. demo.ejemplo.com) Caddy pide el certificado solo (ver server/README.md, «Pasar a un dominio»).
SITE_ADDRESS=:8080

# Token del operador para /events: openssl rand -hex 24
RELAY_TOKEN=

# Origen público de la web (sin barra final): la URL de Funnel https://<nodo>.<tailnet>.ts.net. Varios orígenes, separados por comas.
# Debe estar aquí aunque la web y el relay compartan origen: el navegador envía Origin en el POST.
ALLOWED_ORIGINS=https://nodo.tu-tailnet.ts.net

# Duración máxima de una llamada en segundos (el servidor rechaza > máximo + 5 s; la web se construye con este mismo valor).
MAX_CALL_SECONDS=120

# Llamadas por IP y ventana en minutos. Si Funnel no pasa la IP del cliente, súbelo (p. ej. RATE_LIMIT=60).
RATE_LIMIT=3
RATE_WINDOW_MIN=10
# Cuota por IP: cuentan las llamadas enviadas o pendientes; descartar o caducar sin enviar devuelve la unidad.
# Tope de audios aceptados por IP y ventana (no se devuelve al descartar). Vacío = 3 × RATE_LIMIT.
# UPLOAD_LIMIT=
# Llamadas de una IP esperando «Enviar»: la siguiente recibe 429 (envía o descarta la anterior).
# PENDING_PER_IP=2
# Llamadas retenidas sin enviar en todo el relay; con la cola llena, la «ready» más antigua cede su sitio. Para ~50 personas a la vez: 50.
# MAX_PENDING=20

# Perfil de compose que levanta el Whisper local (`stt`). Quítalo si usas el Whisper del sobremesa (más abajo).
COMPOSE_PROFILES=local-stt

# Modelo de Whisper en CPU. small (~460 MB) es el equilibrio; base/tiny si el VPS va justo.
STT_MODEL=Systran/faster-whisper-small
# Ajuste de velocidad del Whisper local (scripts/stt_server.py): beam 1 = más rápido y algo menos preciso; hilos 0 = por defecto.
# STT_BEAM_SIZE=5
# STT_CPU_THREADS=0

# Puerto local del host (solo 127.0.0.1) que publica Funnel. Cámbialo si 8080 ya está en uso.
WEB_PORT=8080

# LLM opcional del equipo para extraer y traducir (vacío = solo extractor de reglas).
# La clave vive solo en server/relay.env (nunca en el repositorio) y conviene rotarla tras el evento.
# LLM_BASE_URL=https://equipo.tu-tailnet.ts.net:8443/v1
# LLM_MODEL=strata
# LLM_API_KEY=
# LLM_TIMEOUT_MS=20000
# Peticiones simultáneas del relay al LLM (por defecto 2). El gateway limita las conexiones simultáneas por IP
# (8 en el sobremesa; el STT comparte ese límite): sin tope, una ráfaga de llamadas recibe 429.
# LLM_CONCURRENCY=2
# Campos extra (JSON) para el LLM. Con modelos que razonan, desactivar el razonamiento baja de ~65 s a ~5 s:
# LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# Whisper del sobremesa (opcional): en vez del `stt` local, el relay transcribe en el Whisper grande del equipo, tras el mismo
# gateway que el LLM (ver server/README.md). Con esto, quita también COMPOSE_PROFILES y el `stt` local no se levanta.
# El STT del sobremesa debe arrancar con el MISMO MAX_CALL_SECONDS que este archivo.
# STT_BASE_URL=https://equipo.tu-tailnet.ts.net:8443/v1
# STT_MODEL=whisper
# Vacío = reutiliza LLM_API_KEY solo si STT_BASE_URL tiene el mismo origen que LLM_BASE_URL (nunca se envía a otro host).
# STT_API_KEY=
# STT_TIMEOUT_MS=180000
# Reintentos del STT ante 429/502/503/504 o red caída (por defecto 3; 0 = sin reintentos). Mismo motivo: el límite del gateway.
# STT_RETRIES=3

# Segundos que una llamada ya transcrita espera a que la persona pulse «Enviar» antes de caducar (libera su memoria).
# Cuenta desde que el texto está listo, no desde la subida.
# PENDING_TTL_SECONDS=300
